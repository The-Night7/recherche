"doc": "CM05-Recursivite_2023-2024_Informatique2_P1S2_EAnsermin-RGrignon",
"title": "CM05 Recursivite (E. Ansermin)",
"doc_label": "CM05 Recursivite (E. Ansermin) · 2023-2024",
"source": "PREING1-S2/Informatique2/CM05-Recursivite_2023-2024_Informatique2_P1S2_EAnsermin-RGrignon.pdf",
