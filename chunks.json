{
"course": "informatique3",
"curriculum": "preing-2-s1",
"study_year": 2,
"semester": 1,
"kind": "td",
"corrige": true,
"year": 2024,
"doc": "2024-09-27-TD2-Piles-Files-Correction_2024-2025_Informatique3_P2S1_AhmedA",
"title": "TD2",
"doc_label": "TD2 — corrigé · 2024-2025",
