"year": 2024,
"doc": "2024-02-03-TD3-Tableaux-dynamique-Correction_2024-2025_Informatique2_P1S2_DInformatique",
"title": "TD3",
"doc_label": "TD3 — corrigé · 2024-2025",
"source": "PREING1-S2/Informatique2/2024-02-03-TD3-Tableaux-dynamique-Correction_2024-2025_Informatique2_P1S2_DInformatique.md",
