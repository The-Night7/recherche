"text": "Rappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 2 5\nEva ANSERMIN & Romuald GRIGNON\n14\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 2 5\nEva ANSERMIN & Romuald GRIGNON\n15\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 0 5\nEva ANSERMIN & Romuald GRIGNON\n16\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 0 6\nEva ANSERMIN & Romuald GRIGNON\n17\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 0 6\nEva ANSERMIN & Romuald GRIGNON\n18\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 -2 6\nEva ANSERMIN & Romuald GRIGNON\n19\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 -2 7\nEva ANSERMIN & Romuald GRIGNON\n20\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 -2 7\nEva ANSERMIN & Romuald GRIGNON\n21\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 -4 7\nEva ANSERMIN & Romuald GRIGNON\n22\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 -4 8\nEva ANSERMIN & Romuald GRIGNON\n23\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 -4 8\nEva ANSERMIN & Romuald GRIGNON\n24\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 -4 8\n-4\nEva ANSERMIN & Romuald GRIGNON\n25"
