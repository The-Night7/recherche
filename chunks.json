5 \\\\\n\\end{pmatrix}  \n\\overline{\\underline{\n    F1: 59  \\rightarrow   60  \\rightarrow   57 \\rightarrow 23 \\rightarrow 51\n}}$$\n\n\n$$  \\begin{pmatrix} \n    P1 \\\\\n    59 \\\\ \n    \\downarrow  \\\\\n    42 \\\\ \n    \\downarrow  \\\\\n    14 \\\\ \n    \\downarrow  \\\\\n    5 \\\\\n\\end{pmatrix}  \n\\overline{\\underline{\n    F1: 60  \\rightarrow   57 \\rightarrow 23 \\rightarrow 51\n}}$$\n\n\n$$  \\begin{pmatrix} \n    P1 \\\\\n    59 \\\\ \n    \\downarrow  \\\\\n    42 \\\\ \n    \\downarrow  \\\\\n    14 \\\\ \n    \\downarrow  \\\\\n    5 \\\\\n\\end{pmatrix}  \n\\overline{\\underline{\n    F1: 60  \\rightarrow   57 \\rightarrow 23 \\rightarrow 51 \\rightarrow 99\n}}$$\n\n$$  \\begin{pmatrix} \n    P1 \\\\\n    60 \\\\ \n    \\downarrow  \\\\\n    59 \\\\ \n    \\downarrow  \\\\\n    42 \\\\ \n    \\downarrow  \\\\\n    14 \\\\ \n    \\downarrow  \\\\\n    5 \\\\\n\\end{pmatrix}  \n\\overline{\\underline{\n    F1: 57 \\rightarrow 23 \\rightarrow 51 \\rightarrow 99\n}}$$\n\n$$  \\begin{pmatrix} \n    P1 \\\\\n    59 \\\\ \n    \\downarrow  \\\\\n    42 \\\\ \n    \\downarrow  \\\\\n    14 \\\\ \n    \\downarrow  \\\\\n    5 \\\\\n\\end{pmatrix}  \n\\overline{\\underline{\n    F1: 57 \\rightarrow 23 \\rightarrow 51 \\rightarrow 99 \\rightarrow 60\n}}$$\n\n<div id=\"2\"></div>"
