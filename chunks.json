"text": "INFORMATIQUE 1\nV I I I .  F O N C T I O N S ET P R O C É D U R E S\nEva Ansermin & Romuald Grignon \nv1.1\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\nEva ANSERMIN & Romuald GRIGNON\n2\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\nEva ANSERMIN & Romuald GRIGNON\n3\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2\nEva ANSERMIN & Romuald GRIGNON\n4\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 8\nEva ANSERMIN & Romuald GRIGNON\n5\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 8 2\nEva ANSERMIN & Romuald GRIGNON\n6\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 6 2\nEva ANSERMIN & Romuald GRIGNON\n7\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 6 3\nEva ANSERMIN & Romuald GRIGNON\n8\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 6 3\nEva ANSERMIN & Romuald GRIGNON\n9\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 4 3\nEva ANSERMIN & Romuald GRIGNON\n10\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 4 4\nEva ANSERMIN & Romuald GRIGNON\n11\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 4 4\nEva ANSERMIN & Romuald GRIGNON\n12\n\nRappel cours précédent\nPROGRAMME Oracle\nVARIABLES\na,b,i : entier\nDÉBUT\na <- 2\nb <- 8\nPOUR i DE 2 A 8 FAIRE\nb <- b-a \nFIN POUR\nECRIRE(b)\nFIN\na b i\n2 2 4\nEva ANSERMIN & Romuald GRIGNON\n13"
