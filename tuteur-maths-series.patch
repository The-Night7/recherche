+SEC_RE = re.compile(r"(?m)^((?:Thème\s+no\s*\d+)|(?:\d+(?:\.\d+){1,2})\s+[A-ZÉÈÀ][^\n]{2,80})$")
+
+
+def sections_course_pdf(text):
